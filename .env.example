# LiveKit Keys
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>
LIVEKIT_URL=<your-livekit-url>
LIVEKIT_SIP_URI=sip:<your-livekit-sip-uri>

# OpenAI API Key
OPENROUTER_API_KEY=<your-openai-api-key>
OPENROUTER_BASE_URL=<your-openai-base-url>
OPENROUTER_MODEL=google/gemini-2.5-flash

# TTS Provider (cartesia or fishaudio)
TTS_PROVIDER=cartesia

# Fish Audio TTS (required if TTS_PROVIDER=fishaudio)
FISH_API_KEY=<your-fish-audio-api-key>
FISH_AUDIO_REFERENCE_ID=<your-fish-audio-voice-model-id>
FISH_AUDIO_MODEL=s1
FISH_AUDIO_LATENCY=balanced

# Twilio API Keys
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>

# Twilio SIP trunk credentials
TWILIO_SIP_USERNAME=<your-twilio-sip-username>
TWILIO_SIP_PASSWORD=<your-twilio-sip-password>